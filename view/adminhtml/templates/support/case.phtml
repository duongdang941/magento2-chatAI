                                    </div></div></div>
                                </div>
                            <?php endif; ?>
                        <?php endforeach; ?>
                    </div>
                </div>

                <footer class="afd-ai-chat__footer">
                    <form class="afd-ai-chat__composer-shell" data-role="composer"
