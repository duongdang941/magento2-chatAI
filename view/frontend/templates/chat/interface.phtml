<div id="afd-ai-chat-scope">
    <div x-data="aiAgentChat()"
         x-init="initChat()"
         class="afd-ai-chat"
         :data-ui-theme="resolvedUiTheme()"
         :data-ui-density="uiSettings.density"
         :data-ui-font-size="uiSettings.fontSize"
         :data-ui-glass="uiSettings.glassOpacity < 100 ? 'true' : 'false'"
         :class="{ 'afd-ai-chat--dragging': isDragging, 'afd-ai-chat--open': isOpen, 'afd-ai-chat--left': isLauncherOnLeft(), 'afd-ai-chat--top': isLauncherOnTop(), 'afd-ai-chat--window-dragging': isWindowDragging, 'afd-ai-chat--window-resizing': isWindowResizing, 'afd-ai-chat--compact-sidebar': isCompactViewport(), 'afd-ai-chat--narrow': isNarrowViewport(), 'afd-ai-chat--tiny': isTinyViewport(), 'afd-ai-chat--mobile-layout': isMobileLayout(), 'afd-ai-chat--mobile-sidebar-open': isMobileSidebarOpen }"
         :style="rootStyle()"
         @pointermove.window="moveLauncher($event); moveChatWindow($event)"
         @pointerup.window="endLauncherDrag($event); endChatWindowInteraction($event)"
         @pointercancel.window="endLauncherDrag($event); endChatWindowInteraction($event)"
         @keydown.escape.window="isConfirmationDialogOpen ? closeConfirmationDialog() : (isImageViewerOpen ? closeImageViewer() : (isHistorySearchOpen ? closeHistorySearch() : (isSettingsOpen ? closeSettings() : (isMobileSidebarOpen ? closeMobileSidebar() : null))))">
        <div x-show="isOpen"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             x-cloak
             class="afd-ai-chat__backdrop"></div>

        <div x-show="isImageViewerOpen"
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             x-cloak
             class="afd-ai-chat__image-viewer"
             @click.self="closeImageViewer()">
            <section class="afd-ai-chat__image-viewer-dialog"
                     role="dialog"
                     aria-modal="true"
                     :aria-label="'Image preview: ' + currentImageViewerAttachment().name">
                <header class="afd-ai-chat__image-viewer-header">
                    <p class="afd-ai-chat__image-viewer-title"
                       x-text="currentImageViewerAttachment().name"></p>
                    <button type="button"
                            class="afd-ai-chat__image-viewer-close"
                            @click.stop="closeImageViewer()"
                            aria-label="Close image preview"
                            x-ref="imageViewerClose">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </header>
                <div class="afd-ai-chat__image-viewer-stage">
                    <img :src="currentImageViewerAttachment().previewUrl"
                         :alt="currentImageViewerAttachment().name"
                         class="afd-ai-chat__image-viewer-image"
                         decoding="async">
                </div>
            </section>
        </div>

        <div x-ref="chatWindowShell"
             class="afd-ai-chat__window-shell"
             :style="chatWindowStyle()">
            <div x-show="isOpen"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95"
                 x-transition:enter-end="opacity-100 scale-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 scale-100"
                 x-transition:leave-end="opacity-0 scale-95"
                 x-cloak
