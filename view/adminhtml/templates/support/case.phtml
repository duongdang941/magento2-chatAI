                        <input type="hidden" name="entity_id" value="<?= (int)$case->getId() ?>">
                        <div class="afd-ai-chat__composer-editor">
                            <button type="button" class="afd-ai-chat__input-icon-btn" disabled aria-label="<?= $escaper->escapeHtmlAttr(__('Attachments are unavailable')) ?>">+</button>
                            <textarea class="afd-ai-chat__input" name="reply" maxlength="4000" rows="1" required placeholder="<?= $escaper->escapeHtmlAttr(__('Message…')) ?>" aria-label="<?= $escaper->escapeHtmlAttr(__('Reply to this customer')) ?>"></textarea>
                            <div class="afd-ai-chat__composer-bar"><div class="afd-ai-chat__composer-spacer"></div><button type="submit" class="afd-ai-chat__send-btn" aria-label="<?= $escaper->escapeHtmlAttr(__('Send reply')) ?>" disabled>↑</button></div>
                        </div>
                    </form>
                    <div class="afd-ai-support-closed" data-role="closed" <?= $closed ? '' : 'hidden' ?>><?= $escaper->escapeHtml(__('This ticket is closed. Reopen it before replying.')) ?></div>
