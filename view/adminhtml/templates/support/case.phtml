$lastMessageId = $messages ? (int)end($messages)['entity_id'] : 0;
$closed = !$block->canReply();
$chatConfig = [
    '#afd-ai-admin-chat' => [
        'Afd_AI/js/support-chat' => [
            'caseId' => (int)$case->getId(),
            'conversationId' => (int)$case->getData('conversation_id'),
            'messagesUrl' => $block->getMessagesUrl(),
            'replyUrl' => $block->getReplyUrl(),
            'markReadUrl' => $block->getMarkReadUrl(),
            'socketTicketUrl' => $block->getUrl('afd_ai/supportcase/socketTicket'),
            'lastMessageId' => $lastMessageId,
        ],
    ],
];
?>
<div id="afd-ai-chat-scope" class="afd-ai-support-page">
    <div class="afd-ai-support-toolbar">
        <a href="<?= $escaper->escapeUrl($block->getUrl('afd_ai/supportcase/index')) ?>">← <?= $escaper->escapeHtml(__('Support inbox')) ?></a>
        <div><strong><?= $escaper->escapeHtml($block->getContactEmail() ?: (string)__('Unknown email')) ?></strong><span><?= $escaper->escapeHtml(__('%1 ticket(s)', count($tickets))) ?></span></div>
    </div>

