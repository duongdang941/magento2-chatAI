# Never commit real values. Every gateway replica must receive the same secrets.
NODE_ENV=production
PORT=3001

# Fallback before Magento's first signed configuration sync. Each synchronized
# store then supplies its current Magento Base URL, so use this deployment's
# live URL and never a developer-only hostname.
MAGENTO_API_URL=https://shop.example.com

# Redis is mandatory when NODE_ENV=production. Include its credentials in the
# URL; REDIS_PASSWORD by itself is not read by the gateway.
REDIS_URL=rediss://:replace-with-redis-password@redis.example.net:6380/0

# Print these from Magento with: bin/magento afd:ai:gateway:credentials
AI_NODE_SYNC_SECRET=replace-with-the-magento-node-sync-secret
AI_WS_TICKET_SECRET=replace-with-the-magento-websocket-ticket-secret

# Protect /internal/metrics. Use a distinct, long random value.
AI_METRICS_TOKEN=replace-with-a-monitoring-only-secret

# Optional writable path for the encrypted local configuration fallback.
AI_CONFIG_DIRECTORY=./.local

# Provider API keys, models, limits, voice and image settings are intentionally
# omitted: Magento Admin owns them and synchronizes them to the gateway.
