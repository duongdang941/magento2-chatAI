<?php
/**
 * Product Grid Template for AI Chat Messages
 *
 * @var \Afd\AI\Block\Chat\ProductGrid $block
 */
$products = $block->getProducts();
if (!$products || !$products->getSize()) {
    return;
}
?>
<div class="afd-ai-chat__product-grid">
    <?php foreach ($products as $product): ?>
        <?php
        // The search tool has already applied Magento's salability filter. Do
        // not call isSaleable() again here: configurable parents can be
        // considered non-saleable until options are selected, even when their
        // variants were returned as available by the search collection.
        if (!$product) {
            continue;
        }

        $productUrl = $product->getProductUrl();
        $productImageUrl = $block->getProductImageUrl($product);
        $canAddDirectly = $block->canAddToCartDirectly($product);
        ?>
        <div class="afd-ai-chat__product-card">
            <a href="<?= $escaper->escapeUrl($productUrl) ?>"
               target="_blank"
               rel="noopener noreferrer"
               class="afd-ai-chat__product-media-link">
                <div class="afd-ai-chat__product-img-wrap">
                    <img src="<?= $escaper->escapeUrl($productImageUrl) ?>"
                         alt="<?= $escaper->escapeHtmlAttr($product->getName()) ?>"
                         class="afd-ai-chat__product-img"
                         loading="lazy"/>
                </div>
            </a>
            <div class="afd-ai-chat__product-info">
                <a href="<?= $escaper->escapeUrl($productUrl) ?>"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="afd-ai-chat__product-name-link">
                    <h4 class="afd-ai-chat__product-name" title="<?= $escaper->escapeHtmlAttr($product->getName()) ?>">
                        <?= $escaper->escapeHtml($product->getName()) ?>
                    </h4>
                </a>
                <div class="afd-ai-chat__product-pricing">
                    <?= /* @noEscape */ $block->getProductPriceHtml($product) ?>
                </div>

                <div class="afd-ai-chat__product-actions">
                    <?php if ($canAddDirectly): ?>
                        <?php $postData = $block->getAddToCartPostData($product); ?>
                        <form class="afd-ai-chat__product-form" action="<?= $escaper->escapeUrl($postData['action'] ?? $productUrl) ?>" method="post">
                            <?php if (!empty($postData['data']) && is_array($postData['data'])): ?>
                                <?php foreach ($postData['data'] as $name => $value): ?>
                                    <input type="hidden"
                                           name="<?= $escaper->escapeHtmlAttr((string)$name) ?>"
                                           value="<?= $escaper->escapeHtmlAttr(is_scalar($value) ? (string)$value : '') ?>"/>
                                <?php endforeach; ?>
                            <?php endif; ?>
                            <input type="hidden" name="form_key" value="__AFD_FORM_KEY__"/>
                            <button type="submit" class="afd-ai-chat__product-btn afd-ai-chat__product-btn--primary">
                                <span class="material-symbols-outlined">shopping_cart</span>
                                <span>Add to Cart</span>
                            </button>
                        </form>
                    <?php else: ?>
                        <a href="<?= $escaper->escapeUrl($productUrl) ?>"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="afd-ai-chat__product-btn afd-ai-chat__product-btn--primary">
                            <span class="material-symbols-outlined">tune</span>
                            <span>Choose options</span>
                        </a>
                    <?php endif; ?>
                </div>
            </div>
        </div>
    <?php endforeach; ?>
</div>
