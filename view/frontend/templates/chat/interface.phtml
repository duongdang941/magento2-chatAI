         :class="{ 'afd-ai-chat--dragging': isDragging, 'afd-ai-chat--open': isOpen, 'afd-ai-chat--left': isLauncherOnLeft(), 'afd-ai-chat--top': isLauncherOnTop(), 'afd-ai-chat--window-dragging': isWindowDragging, 'afd-ai-chat--window-resizing': isWindowResizing, 'afd-ai-chat--compact-sidebar': isCompactViewport(), 'afd-ai-chat--narrow': isNarrowViewport(), 'afd-ai-chat--tiny': isTinyViewport(), 'afd-ai-chat--mobile-layout': isMobileLayout(), 'afd-ai-chat--mobile-sidebar-open': isMobileSidebarOpen }"
         :style="rootStyle()"
         @pointermove.window="moveLauncher($event); moveChatWindow($event)"
         @pointerup.window="endLauncherDrag($event); endChatWindowInteraction($event)"
         @pointercancel.window="endLauncherDrag($event); endChatWindowInteraction($event)"
         @keydown.escape.window="isConfirmationDialogOpen ? closeConfirmationDialog() : (isImageViewerOpen ? closeImageViewer() : (isHistorySearchOpen ? closeHistorySearch() : (isSettingsOpen ? closeSettings() : (isMobileSidebarOpen ? closeMobileSidebar() : null))))">
        <div x-show="isOpen"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
