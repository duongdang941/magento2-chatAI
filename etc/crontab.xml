<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="afd_ai_cleanup_expired_data"
             instance="Afd\AI\Cron\CleanupExpiredData"
             method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
        <job name="afd_ai_reconcile_attachment_quota"
             instance="Afd\AI\Cron\ReconcileAttachmentQuota"
             method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
    </group>
</config>
