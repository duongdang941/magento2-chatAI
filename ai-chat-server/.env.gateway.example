# Never commit real values. Every gateway replica must receive the same secrets.
MAGENTO_API_URL=http://host.docker.internal
MAGENTO_HOST=afd.test
REDIS_PASSWORD=replace-with-a-long-random-secret
AI_NODE_SYNC_SECRET=replace-with-the-magento-node-sync-secret
AI_WS_TICKET_SECRET=replace-with-the-magento-websocket-ticket-secret
AI_METRICS_TOKEN=replace-with-a-monitoring-only-secret
# Port the gateway listens on (server.js reads PORT; defaults to 3001).
# GATEWAY_PORT only maps the host port in compose.yaml.
PORT=3001
MAX_MESSAGES_PER_MINUTE=15
MAX_CONCURRENT_MODEL_REQUESTS=32
MAX_QUEUE_DEPTH=200
MAX_QUEUE_WAIT_MS=30000
MODEL_LEASE_MS=90000
# Opt-in only: probe alternate provider endpoints when the configured base URL
# is unreachable. Off by default so merchant credentials are never sent to any
# hardcoded fallback host.
#AI_FALLBACK_ROUTES_ENABLED=1
