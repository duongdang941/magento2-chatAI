                                        aria-pressed="<?= $selected ? 'true' : 'false' ?>">
                                    <span class="afd-ai-support-ticket-icon" aria-hidden="true">#</span>
                                    <span class="afd-ai-chat__sidebar-item-copy">
                                        <span class="afd-ai-chat__sidebar-item-title">
                                            <span class="afd-ai-chat__sidebar-item-title-track"><?= $escaper->escapeHtml((string)$ticket['subject']) ?></span>
                                        </span>
                                        <span class="afd-ai-support-ticket-meta">
