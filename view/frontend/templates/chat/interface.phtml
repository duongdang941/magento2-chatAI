                     role="dialog"
                     aria-modal="true"
                     :aria-label="'Image preview: ' + currentImageViewerAttachment().name">
                <header class="afd-ai-chat__image-viewer-header">
                    <p class="afd-ai-chat__image-viewer-title"
                       x-text="currentImageViewerAttachment().name"></p>
                    <button type="button"
                            class="afd-ai-chat__image-viewer-close"
