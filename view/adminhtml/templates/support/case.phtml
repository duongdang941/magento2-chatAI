        </section>
    </div>
</div>
<script type="text/x-magento-init">
<?= /* @noEscape */ json_encode($chatConfig, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_AMP | JSON_HEX_QUOT) ?>
