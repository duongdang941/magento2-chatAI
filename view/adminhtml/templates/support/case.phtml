                                            <span><?= $escaper->escapeHtml((string)$ticket['status']) ?></span>
                                        </span>
                                    </span>
                                    <?php if ((int)$ticket['admin_unread_count'] > 0): ?>
                                        <span class="afd-ai-support-unread" data-role="unread-count"><?= (int)$ticket['admin_unread_count'] ?></span>
                                    <?php endif; ?>
                                </button>
                            </div>
                        <?php endforeach; ?>
                    </div>
                </div>
            </aside>

