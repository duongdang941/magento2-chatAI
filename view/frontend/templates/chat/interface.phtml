<div id="afd-ai-chat-scope">
    <div x-data="aiAgentChat()"
         x-init="initChat()"
         class="afd-ai-chat"
         :data-ui-theme="resolvedUiTheme()"
         :data-ui-density="uiSettings.density"
         :data-ui-font-size="uiSettings.fontSize"
