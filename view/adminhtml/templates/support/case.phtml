                            <?php if ($isAgent): ?>
                                <div class="afd-ai-chat__msg-user" data-message-id="<?= (int)$message['entity_id'] ?>">
                                    <div class="afd-ai-chat__msg-user-content"><div class="afd-ai-chat__msg-user-stack"><div class="afd-ai-chat__msg-bubble-user"><div class="afd-ai-chat__msg-user-text"><?= /* @noEscape */ nl2br($escaper->escapeHtml($message['text'])) ?></div></div></div></div>
                                </div>
                            <?php else: ?>
                                <div class="afd-ai-chat__msg-ai" data-message-id="<?= (int)$message['entity_id'] ?>">
                                    <div class="afd-ai-chat__msg-content"><div class="afd-ai-chat__msg-assistant-stack"><div class="<?= $isCustomer ? 'afd-ai-chat__msg-bubble-customer' : 'afd-ai-chat__msg-bubble-ai' ?>">
