                            <span class="afd-ai-chat__brand-icon afd-ai-support-brand-icon" aria-hidden="true">S</span>
                            <div>
                                <p class="afd-ai-chat__brand-name"><?= $escaper->escapeHtml(__('Human Support')) ?></p>
                                <p class="afd-ai-chat__brand-sub"><?= $escaper->escapeHtml($block->getContactEmail()) ?></p>
                            </div>
                        </div>
                    </div>
                    <div class="afd-ai-chat__sidebar-label afd-ai-support-sidebar-label">
                        <h3><?= $escaper->escapeHtml(__('Tickets')) ?> <span class="afd-ai-support-ticket-total"><?= count($tickets) ?></span></h3>
                    </div>
                    <div class="afd-ai-chat__sidebar-list custom-scrollbar" data-role="ticket-list">
