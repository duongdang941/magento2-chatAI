                <div x-show="isOpen && canManipulateChatWindow()"
                     x-cloak
                     class="afd-ai-chat__resize-handle"
                     :class="'afd-ai-chat__resize-handle--' + direction"
                     @pointerdown.prevent.stop="startChatWindowResize($event, direction)"
                     aria-hidden="true"></div>
            </template>
        </div>

        <?= $block->getChildHtml('launcher') ?>
