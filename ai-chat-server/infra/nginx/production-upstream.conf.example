# Load this file from the Nginx `http {}` context, not from a `server {}`
# block. Replace service names with the three deployed gateway addresses.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_zone $binary_remote_addr zone=afd_ai_connection_rate:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=afd_ai_connection_limit:10m;

upstream afd_ai_gateway_replicas {
    least_conn;
    server 10.0.20.11:3001 max_fails=3 fail_timeout=15s;
    server 10.0.20.12:3001 max_fails=3 fail_timeout=15s;
    server 10.0.20.13:3001 max_fails=3 fail_timeout=15s;
    keepalive 64;
}
