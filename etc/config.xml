<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <afd_ai>
            <general>
                <enabled>0</enabled>
                <persist_guest_history>1</persist_guest_history>
                <chat_server_url>ws://127.0.0.1:3001</chat_server_url>
                <provider>cockpit</provider>
                <cockpit_base_url>http://127.0.0.1:49998/v1</cockpit_base_url>
                <cockpit_model>gpt-5.6-luna</cockpit_model>
                <image_generation_enabled>1</image_generation_enabled>
                <cockpit_image_model>gpt-image-2</cockpit_image_model>
                <cockpit_image_size>1024x1024</cockpit_image_size>
                <cockpit_image_quality>medium</cockpit_image_quality>
            </general>
            <agent>
                <max_tool_rounds>8</max_tool_rounds>
                <max_tool_executions>15</max_tool_executions>
                <max_category_calls>3</max_category_calls>
                <block_duplicate_tool_calls>1</block_duplicate_tool_calls>
                <max_output_tokens>2048</max_output_tokens>
                <max_model_history_messages>20</max_model_history_messages>
                <provider_stream_timeout_ms>120000</provider_stream_timeout_ms>
            </agent>
            <image_generation>
                <timeout_ms>180000</timeout_ms>
                <customer_per_hour>3</customer_per_hour>
                <customer_per_day>10</customer_per_day>
                <guest_per_hour>2</guest_per_hour>
                <guest_per_day>5</guest_per_day>
                <cooldown_seconds>60</cooldown_seconds>
                <max_concurrent_per_identity>1</max_concurrent_per_identity>
            </image_generation>
            <rate_limits>
                <messages_per_minute>15</messages_per_minute>
                <product_pages_per_minute>30</product_pages_per_minute>
                <address_updates_per_minute>5</address_updates_per_minute>
                <address_updates_per_hour>20</address_updates_per_hour>
            </rate_limits>
            <capacity>
                <concurrent_model_requests>32</concurrent_model_requests>
                <queue_depth>200</queue_depth>
                <queue_wait_ms>30000</queue_wait_ms>
                <model_lease_ms>180000</model_lease_ms>
            </capacity>
            <attachments>
                <max_image_bytes>4194304</max_image_bytes>
                <max_images_per_message>4</max_images_per_message>
            </attachments>
            <voice>
                <enabled>1</enabled>
                <transcription_model>gpt-4o-mini-transcribe</transcription_model>
                <max_duration_seconds>120</max_duration_seconds>
                <max_audio_bytes>4194304</max_audio_bytes>
                <requests_per_minute>6</requests_per_minute>
                <max_concurrent_per_identity>1</max_concurrent_per_identity>
                <timeout_ms>120000</timeout_ms>
                <live_enabled>0</live_enabled>
                <live_model>gpt-realtime-1.5</live_model>
                <live_max_sessions_per_minute>3</live_max_sessions_per_minute>
                <live_max_duration_seconds>600</live_max_duration_seconds>
            </voice>
            <knowledge>
                <enabled>1</enabled>
            </knowledge>
            <support>
                <enabled>1</enabled>
            </support>
            <privacy>
                <conversation_retention_days>90</conversation_retention_days>
                <resolved_case_retention_days>365</resolved_case_retention_days>
            </privacy>
        </afd_ai>
    </default>
</config>
