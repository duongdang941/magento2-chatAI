<?php
/** @var \Afd\AI\Block\Adminhtml\Knowledge\Manager $block */
/** @var \Magento\Framework\Escaper $escaper */
$document = $block->getDocument();
$date = static fn ($value): string => $value ? date('Y-m-d\\TH:i', strtotime((string)$value)) : '';
?>
<div class="admin__fieldset-wrapper">
    <div class="admin__fieldset-wrapper-title"><strong class="title"><?= $escaper->escapeHtml($document ? __('Edit Knowledge Document') : __('Add Knowledge Document')) ?></strong></div>
    <div class="admin__fieldset-wrapper-content">
        <form method="post" action="<?= $escaper->escapeUrl($block->getUrl('afd_ai/knowledge/save')) ?>">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="entity_id" value="<?= (int)($document['entity_id'] ?? 0) ?>">
            <fieldset class="admin__fieldset">
                <div class="admin__field field required"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Title')) ?></span></label><div class="admin__field-control"><input class="admin__control-text" required name="title" value="<?= $escaper->escapeHtmlAttr((string)($document['title'] ?? '')) ?>"></div></div>
                <div class="admin__field field required"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Identifier')) ?></span></label><div class="admin__field-control"><input class="admin__control-text" required name="identifier" placeholder="shipping-policy" value="<?= $escaper->escapeHtmlAttr((string)($document['identifier'] ?? '')) ?>"><div class="note"><?= $escaper->escapeHtml(__('Stable source name used in citations.')) ?></div></div></div>
                <div class="admin__field field"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Status')) ?></span></label><div class="admin__field-control"><select class="admin__control-select" name="status"><?php foreach (['draft','review','published','archived'] as $status): ?><option value="<?= $status ?>" <?= ($document['status'] ?? 'draft') === $status ? 'selected' : '' ?>><?= $escaper->escapeHtml(ucfirst($status)) ?></option><?php endforeach; ?></select></div></div>
                <div class="admin__field field"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Store View')) ?></span></label><div class="admin__field-control"><select class="admin__control-select" name="store_id"><option value="0"><?= $escaper->escapeHtml(__('All store views')) ?></option><?php foreach ($block->getStores() as $store): ?><option value="<?= (int)$store['id'] ?>" <?= (int)($document['store_id'] ?? 0) === (int)$store['id'] ? 'selected' : '' ?>><?= $escaper->escapeHtml($store['name'] . ' (' . $store['code'] . ')') ?></option><?php endforeach; ?></select></div></div>
                <div class="admin__field field"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Customer Group')) ?></span></label><div class="admin__field-control"><select class="admin__control-select" name="customer_group_id"><option value="0"><?= $escaper->escapeHtml(__('All customer groups')) ?></option><?php foreach ($block->getCustomerGroups() as $group): ?><option value="<?= (int)$group['id'] ?>" <?= (int)($document['customer_group_id'] ?? 0) === (int)$group['id'] ? 'selected' : '' ?>><?= $escaper->escapeHtml($group['name']) ?></option><?php endforeach; ?></select><div class="note"><?= $escaper->escapeHtml(__('A group-scoped document is retrieved only for the matching Magento-signed shopper group.')) ?></div></div></div>
                <div class="admin__field field"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Language')) ?></span></label><div class="admin__field-control"><input class="admin__control-text" name="language" placeholder="en" value="<?= $escaper->escapeHtmlAttr((string)($document['language'] ?? '')) ?>"></div></div>
                <div class="admin__field field"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Source URL')) ?></span></label><div class="admin__field-control"><input class="admin__control-text" type="url" name="source_url" value="<?= $escaper->escapeHtmlAttr((string)($document['source_url'] ?? '')) ?>"></div></div>
                <div class="admin__field field"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Effective From')) ?></span></label><div class="admin__field-control"><input class="admin__control-text" type="datetime-local" name="effective_at" value="<?= $escaper->escapeHtmlAttr($date($document['effective_at'] ?? '')) ?>"></div></div>
                <div class="admin__field field"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Expires At')) ?></span></label><div class="admin__field-control"><input class="admin__control-text" type="datetime-local" name="expires_at" value="<?= $escaper->escapeHtmlAttr($date($document['expires_at'] ?? '')) ?>"></div></div>
                <div class="admin__field field required"><label class="admin__field-label"><span><?= $escaper->escapeHtml(__('Authoritative Content')) ?></span></label><div class="admin__field-control"><textarea class="admin__control-textarea" required name="content" rows="12"><?= $escaper->escapeHtml((string)($document['content'] ?? '')) ?></textarea><div class="note"><?= $escaper->escapeHtml(__('Only published, in-scope documents are returned to the assistant.')) ?></div></div></div>
                <div class="admin__field"><div class="admin__field-control"><button class="action-primary" type="submit"><span><?= $escaper->escapeHtml(__('Save Document')) ?></span></button> <?php if ($document): ?><a class="action-secondary" href="<?= $escaper->escapeUrl($block->getUrl('afd_ai/knowledge/index')) ?>"><?= $escaper->escapeHtml(__('Cancel')) ?></a><?php endif; ?></div></div>
            </fieldset>
        </form>
    </div>
</div>
<div class="admin__fieldset-wrapper">
    <div class="admin__fieldset-wrapper-title"><strong class="title"><?= $escaper->escapeHtml(__('Documents')) ?></strong></div>
    <div class="admin__fieldset-wrapper-content"><table class="data-grid"><thead><tr><th class="data-grid-th"><?= $escaper->escapeHtml(__('Title')) ?></th><th class="data-grid-th"><?= $escaper->escapeHtml(__('Store Scope')) ?></th><th class="data-grid-th"><?= $escaper->escapeHtml(__('Customer Group')) ?></th><th class="data-grid-th"><?= $escaper->escapeHtml(__('Status')) ?></th><th class="data-grid-th"><?= $escaper->escapeHtml(__('Version')) ?></th><th class="data-grid-th"><?= $escaper->escapeHtml(__('Updated')) ?></th><th class="data-grid-th"><?= $escaper->escapeHtml(__('Actions')) ?></th></tr></thead><tbody><?php foreach ($block->getDocuments() as $row): ?><tr class="data-row"><td><?= $escaper->escapeHtml((string)$row['title']) ?><br><small><?= $escaper->escapeHtml((string)$row['identifier']) ?></small></td><td><?= (int)$row['store_id'] === 0 ? $escaper->escapeHtml(__('All stores')) : (int)$row['store_id'] ?></td><td><?= (int)($row['customer_group_id'] ?? 0) === 0 ? $escaper->escapeHtml(__('All groups')) : (int)$row['customer_group_id'] ?></td><td><?= $escaper->escapeHtml((string)$row['status']) ?></td><td><?= (int)$row['version'] ?></td><td><?= $escaper->escapeHtml((string)$row['updated_at']) ?></td><td><a href="<?= $escaper->escapeUrl($block->getUrl('afd_ai/knowledge/index', ['id' => (int)$row['entity_id']])) ?>"><?= $escaper->escapeHtml(__('Edit')) ?></a> <form style="display:inline" method="post" action="<?= $escaper->escapeUrl($block->getUrl('afd_ai/knowledge/delete')) ?>" onsubmit="return confirm('Delete this knowledge document?')"><?= $block->getBlockHtml('formkey') ?><input type="hidden" name="id" value="<?= (int)$row['entity_id'] ?>"><button type="submit" class="action-secondary"><span><?= $escaper->escapeHtml(__('Delete')) ?></span></button></form></td></tr><?php endforeach; ?></tbody></table></div>
</div>
