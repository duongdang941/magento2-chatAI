<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="afd" translate="label" sortOrder="900">
            <label>Store Assistant</label>
        </tab>
        <section id="afd_ai" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>AI Assistant</label>
            <tab>afd</tab>
            <resource>Afd_AI::config_afd_ai</resource>

            <!-- General Chat Group -->
            <group id="general" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Chat</label>

                <!-- Enable Store Assistant (Top Level Master Switch) -->
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Store Assistant</label>
                    <comment>Enable AI chat for storefront shoppers.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <frontend_model>Afd\AI\Block\Adminhtml\System\Config\EnableField</frontend_model>
                </field>

                <!-- AI Provider (Immediately below Enable Store Assistant) -->
                <field id="provider" translate="label comment" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>AI Provider</label>
                    <comment>Choose the active Model Provider configured in Model Providers.</comment>
                    <config_path>afd_ai/general/provider</config_path>
                    <source_model>Afd\AI\Model\Config\Source\AiProvider</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <!-- AI Model (Immediately below AI Provider) -->
                <field id="model" translate="label comment" type="select" sortOrder="18" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>AI Model</label>
                    <comment>Select the model to serve chat completions.</comment>
                    <config_path>afd_ai/general/model</config_path>
                    <source_model>Afd\AI\Model\Config\Source\AiModel</source_model>
                    <frontend_model>Afd\AI\Block\Adminhtml\System\Config\ModelSelect</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="thought_level" translate="label comment" type="select" sortOrder="19" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Thought Level</label>
                    <comment>Visible only when the selected model supports configurable reasoning.</comment>
                    <config_path>afd_ai/general/thought_level</config_path>
                    <source_model>Afd\AI\Model\Config\Source\ThoughtLevel</source_model>
                    <frontend_model>Afd\AI\Block\Adminhtml\System\Config\ThoughtLevelSelect</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="persist_guest_history" translate="label comment" type="select" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Persist Guest Chat History</label>
                    <comment>Store guest conversations in the AI database so they remain available after the browser is reopened. Ownership uses an opaque, HTTP-only browser identifier.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="expose_coupon_codes" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Allow AI to Share Coupon Codes</label>
                    <comment>Disabled by default. Enable only for coupon rules whose codes are safe to disclose to every eligible shopper in this store view.</comment>
                    <config_path>afd_ai/features/expose_coupon_codes</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="chat_server_url" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Chat Server WebSocket URL</label>
                    <comment>Optional override for a local or separate gateway. Leave empty in production to use this store's secure Base URL with /ai-gateway/.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="features" translate="label comment" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Rollout &amp; Experimental Features</label>
                <comment>Per-store kill switches for new customer-facing capabilities. Leave a feature disabled until its acceptance tests and rollout plan are approved.</comment>
                <field id="candidate_memory_enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Candidate Memory</label>
                    <comment>Allows the Product Advisor rollout to retain verified product references between turns. Disabled until that flow is released.</comment>
                    <config_path>afd_ai/features/candidate_memory_enabled</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="product_advisor_enabled" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Product Advisor</label>
                    <comment>Enables the guided product-finder experience after its release gate has passed.</comment>
                    <config_path>afd_ai/features/product_advisor_enabled</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="proactive_suggestions_enabled" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Proactive Suggestions</label>
                    <comment>Allows contextual suggestions only for this store after shopper-interaction and consent rules have been configured.</comment>
                    <config_path>afd_ai/features/proactive_suggestions_enabled</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="analytics_attribution_enabled" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable AI Attribution Events</label>
                    <comment>Enables assisted-conversion event collection after storefront consent and the attribution data model are released.</comment>
                    <config_path>afd_ai/features/analytics_attribution_enabled</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="guardrails_enabled" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Commerce Guardrails</label>
                    <comment>Applies provider-neutral authorization checks for customer, verified-order, destructive and paid actions. Keep enabled in every production store.</comment>
                    <config_path>afd_ai/features/guardrails_enabled</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="attachments" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Images &amp; Attachments</label>
                <comment>Image generation and attachment controls.</comment>
                <group id="generation" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Image Generation</label>
                    <comment>These settings control image requests after a provider image model has been configured.</comment>
                    <field id="image_generation_enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Enable Image Generation</label>
                        <comment>Allow the selected AI provider to generate images.</comment>
                        <config_path>afd_ai/general/image_generation_enabled</config_path>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <depends>
                            <field id="afd_ai/general/enabled">1</field>
                        </depends>
                    </field>
                    <field id="image_transport" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Image API</label>
                        <comment>Choose the image transport for the selected provider and model. Leave empty to use the safe SVG fallback.</comment>
                        <config_path>afd_ai/image_generation/transport</config_path>
                        <source_model>Afd\AI\Model\Config\Source\ImageTransport</source_model>
                        <depends>
                            <field id="afd_ai/general/enabled">1</field>
                            <field id="image_generation_enabled">1</field>
                        </depends>
                    </field>
                    <field id="image_model" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Image Model</label>
                        <comment>Optional provider image model. Leave empty when the selected Image API chooses its own model.</comment>
                        <config_path>afd_ai/image_generation/model</config_path>
                        <depends>
                            <field id="afd_ai/general/enabled">1</field>
                            <field id="image_generation_enabled">1</field>
                        </depends>
                    </field>
                    <field id="image_size" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Generated Image Size</label>
                        <config_path>afd_ai/general/cockpit_image_size</config_path>
                        <source_model>Afd\AI\Model\Config\Source\ImageSize</source_model>
                        <depends>
                            <field id="afd_ai/general/enabled">1</field>
                            <field id="image_generation_enabled">1</field>
                        </depends>
                    </field>
                    <field id="image_timeout_ms" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Image Generation Timeout (Milliseconds)</label>
                        <comment>Allowed range: 30000–300000.</comment>
                        <config_path>afd_ai/image_generation/timeout_ms</config_path>
                        <validate>validate-number validate-greater-than-zero</validate>
                        <depends>
                            <field id="afd_ai/general/enabled">1</field>
                            <field id="image_generation_enabled">1</field>
                        </depends>
                    </field>
                </group>
            </group>

            <group id="rate_limiting" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Traffic Guardrails</label>
                <field id="messages_per_minute" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Messages Per Minute</label>
                    <comment>Allowed range: 1–300.</comment>
                    <config_path>afd_ai/rate_limits/messages_per_minute</config_path>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="capacity" translate="label" type="text" sortOrder="45" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Concurrency &amp; Queueing</label>
                <field id="concurrent_model_requests" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Maximum Concurrent Requests</label>
                    <comment>Allowed range: 1–500.</comment>
                    <config_path>afd_ai/capacity/concurrent_model_requests</config_path>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="store_knowledge" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Magento Content</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Search Magento CMS Content</label>
                    <comment>Use active CMS pages and blocks as authoritative sources for policies, delivery, payment, warranty and FAQ answers.</comment>
                    <config_path>afd_ai/knowledge/enabled</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="human_handoff" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Support Team</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Human Handoff</label>
                    <config_path>afd_ai/support/enabled</config_path>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="recipient_email" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Support Queue Email</label>
                    <comment>Cases are always saved before email is attempted.</comment>
                    <config_path>afd_ai/support/recipient_email</config_path>
                    <validate>validate-email</validate>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="privacy_retention" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Data Retention</label>
                <field id="conversation_retention_days" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Conversation Retention (Days)</label>
                    <comment>Allowed range: 1–730 days.</comment>
                    <config_path>afd_ai/privacy/conversation_retention_days</config_path>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="analytics_event_retention_days" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Attribution Event Retention (Days)</label>
                    <comment>Daily cleanup deletes AI attribution events older than this. Allowed range: 30–3650 days.</comment>
                    <config_path>afd_ai/privacy/analytics_event_retention_days</config_path>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="guardrail_audit_retention_days" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Guardrail Audit Retention (Days)</label>
                    <comment>Daily cleanup deletes guardrail decision records older than this. Allowed range: 30–3650 days.</comment>
                    <config_path>afd_ai/privacy/guardrail_audit_retention_days</config_path>
                    <validate>validate-number validate-greater-than-zero</validate>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="magento_oauth" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Magento OAuth</label>
                <field id="consumer_key" translate="label" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Consumer Key</label>
                    <config_path>afd_ai/general/magento_consumer_key</config_path>
                    <backend_model>Afd\AI\Model\Config\Backend\VisibleValue</backend_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="consumer_secret" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Consumer Secret</label>
                    <config_path>afd_ai/general/magento_consumer_secret</config_path>
                    <backend_model>Afd\AI\Model\Config\Backend\VisibleValue</backend_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="access_token" translate="label" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Access Token</label>
                    <config_path>afd_ai/general/magento_access_token</config_path>
                    <backend_model>Afd\AI\Model\Config\Backend\VisibleValue</backend_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="access_token_secret" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Access Token Secret</label>
                    <config_path>afd_ai/general/magento_access_token_secret</config_path>
                    <backend_model>Afd\AI\Model\Config\Backend\VisibleValue</backend_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="gateway_security" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Gateway Security &amp; Sync</label>
                <field id="node_sync_secret" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Node Service HMAC Secret</label>
                    <comment>This value is read-only so an Admin configuration save cannot change it. Copy it to every Node gateway as AI_NODE_SYNC_SECRET. To retrieve both active Node credentials from the command line, run: bin/magento afd:ai:gateway:credentials</comment>
                    <config_path>afd_ai/general/node_sync_secret</config_path>
                    <backend_model>Afd\AI\Model\Config\Backend\ProtectedGatewaySecret</backend_model>
                    <frontend_model>Afd\AI\Block\Adminhtml\System\Config\GatewaySecret</frontend_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="ws_ticket_secret" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>WebSocket Ticket Secret</label>
                    <comment>This value is read-only so an Admin configuration save cannot change it. Copy it to every Node gateway as AI_WS_TICKET_SECRET. To retrieve both active Node credentials from the command line, run: bin/magento afd:ai:gateway:credentials</comment>
                    <config_path>afd_ai/general/ws_ticket_secret</config_path>
                    <backend_model>Afd\AI\Model\Config\Backend\ProtectedGatewaySecret</backend_model>
                    <frontend_model>Afd\AI\Block\Adminhtml\System\Config\GatewaySecret</frontend_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
                <field id="node_sync_status" translate="label" type="note" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Node Configuration Sync Status</label>
                    <config_path>afd_ai/general/node_sync_status</config_path>
                    <frontend_model>Afd\AI\Block\Adminhtml\System\Config\NodeSyncStatus</frontend_model>
                    <depends>
                        <field id="afd_ai/general/enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
